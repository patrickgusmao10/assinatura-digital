# Copie para .env e ajuste. NUNCA versione o .env.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=troque-esta-senha-forte
# Produção: string de conexão do MongoDB Atlas (mongodb+srv://...)
MONGODB_URI=mongodb://admin:troque-esta-senha-forte@mongo:27017/assinatura?authSource=admin

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Origem(ns) permitida(s) do frontend. Produção: https://SEU-USUARIO.github.io
CORS_ORIGIN=http://localhost:3000
# Local: lax/false. Produção (front e API em domínios diferentes): none/true (exige HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Gerente inicial (criado apenas se o banco estiver vazio)
SEED_MANAGER_NAME=Gerente Geral
SEED_MANAGER_EMAIL=gerente@empresa.com
SEED_MANAGER_PASSWORD=SenhaForte@2026

# E-mail (Nodemailer). Local usa o MailHog; produção, seu provedor SMTP.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Assinatura Digital <no-reply@empresa.com>
UPLOAD_DIR=/data/uploads

# Usados apenas pelo docker-compose (build do frontend e CSP do nginx)
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_API_ORIGIN=http://localhost:4000
